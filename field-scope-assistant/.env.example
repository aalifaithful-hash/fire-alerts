# Required for AI analysis (PDF reading, scope drafting, corrections).
# Server-side only - never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional: model override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional but recommended when the app is reachable by anyone else:
# a passcode required to open the app. Leave empty for local single-user use.
APP_PASSCODE=

# Optional: secret used to sign the session cookie (defaults to a value derived from APP_PASSCODE)
# SESSION_SECRET=

# Optional: where the SQLite database and uploaded PDFs are stored (default ./data)
# DATA_DIR=./data
