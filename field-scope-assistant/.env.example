# AI provider — selected by environment variable only (no code change to switch).
#   AI_PROVIDER=none       (default) AI off; everything else works (manual drafting,
#                          PDF text extraction, room-by-room scan, sketch, exports).
#   AI_PROVIDER=anthropic  Anthropic Claude — needs ANTHROPIC_API_KEY
#   AI_PROVIDER=gemini     Google Gemini   — needs GEMINI_API_KEY (Google AI Studio)
# Keys are server-side only and never sent to the browser.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5 / gemini-3.8-flash)
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash

# Optional but recommended when the app is reachable by anyone else:
# a passcode required to open the app. Leave empty for local single-user use.
APP_PASSCODE=

# Optional: secret used to sign the session cookie (defaults to a value derived from APP_PASSCODE)
# SESSION_SECRET=

# Database (set automatically by the Vercel–Neon integration). Local: pglite://memory
# DATABASE_URL=
# Private Vercel Blob store for PDFs (set by connecting the store). Unset locally = files under DATA_DIR.
# BLOB_READ_WRITE_TOKEN=
# Optional: local file storage when there is no Blob token (default ./.data)
# DATA_DIR=./.data
